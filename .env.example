# EXE PRO 3.5.0 - Cloudways Velocity
NODE_ENV=production
EXE_CLOUD_PUBLIC_URL=https://app.exekuta.com.br
EXE_CLOUD_REQUIRE_HTTPS=1
EXE_CLOUD_KEY=
EXE_CLOUD_SECRET_KEY=
EXE_CLOUD_ADMIN_USER=admin
# Recomendado: hash gerado com `npm run hash-password -- "SUA SENHA"`
EXE_CLOUD_ADMIN_PASSWORD_HASH=
# Alternativa para o primeiro boot (marcar Sensitive no Cloudways):
EXE_CLOUD_ADMIN_PASSWORD=
EXE_CLOUD_WEB_SESSION_HOURS=12

# PostgreSQL: use DATABASE_URL OU as variaveis DB_* fornecidas pelo ambiente.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
EXE_CLOUD_DB_SSL=0
EXE_CLOUD_DB_SSL_VERIFY=1
